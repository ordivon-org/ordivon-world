{
  "name": "@ordivon/edge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26",
    "pnpm": ">=10"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "check:boundary": "node scripts/check-boundary.mjs",
    "build": "wrangler deploy --dry-run --outdir dist",
    "ci": "pnpm typecheck && pnpm test && pnpm check:boundary && pnpm build"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260727.1",
    "@types/node": "26.1.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "wrangler": "4.114.0"
  }
}
