{
  "schema_version": 1,
  "kind": "ordivon-world-capability-portfolio",
  "authority": "read-only projection of adapter-local declarations",
  "writable_registry": false,
  "adapters": [
    {
      "adapter_id": "cloudflare",
      "adapter_revision": "0.1.0",
      "authority": [
        "provider request identity and idempotency digest",
        "provider pending and committed request state",
        "provider Receipt and Artifact metadata",
        "provider capability, policy, Worker version, release and retention state"
      ],
      "capabilities": [
        {
          "contract": "fetch.v2",
          "execution_mode": "immediate-pollable-receipt",
          "id": "fetch",
          "state": "ready"
        },
        {
          "contract": "browser.run.v2",
          "execution_mode": "immediate-pollable-receipt",
          "id": "browser.run",
          "state": "ready"
        },
        {
          "contract": "artifact.reference.v1",
          "execution_mode": "provider-addressed-private-object",
          "id": "artifact.r2",
          "state": "ready"
        },
        {
          "contract": "receipt.v2",
          "execution_mode": "inspect-original-request",
          "id": "receipt",
          "state": "ready"
        },
        {
          "contract": "evidence.run.v1",
          "execution_mode": "durable-workflow",
          "id": "evidence.run",
          "state": "ready"
        }
      ],
      "consequence_class": "bounded external read, browser execution, durable provider workflow and private Artifact write",
      "cost_model": {
        "fixed": "one Worker deployment, R2 retention, release and cleanup operations",
        "variable": "provider-native request, Browser, Workflow and storage usage"
      },
      "deletion_trigger": "delete an unused capability or adapter facet when no recurring consumer remains and direct provider use has lower total cost",
      "facets": [
        "capability",
        "dispatch",
        "inspect-result",
        "artifact",
        "cancel-close"
      ],
      "owner": "provider-adapter",
      "real_consumers": [
        "ordivon-computer research-source capture",
        "ordivon-world provider post-deployment acceptance"
      ],
      "retention_source": "config/edge-policy.json and Workflow instance retention",
      "schema_version": 1,
      "declaration_path": "providers/cloudflare/capability.json",
      "declaration_sha256": "af33f0cfa3fd7493b9213f4d7d82d5a1682c15e8bd0a1b47e7e9faa8dfa975c5"
    },
    {
      "adapter_id": "network-observation",
      "adapter_revision": "0.1.0",
      "authority": [
        "method-bound DNS, HTTP, TLS, QUIC, transfer and connection-lifetime observations",
        "observation time, target, probe revision and raw result",
        "sanitized local observation history"
      ],
      "capabilities": [
        {
          "contract": "probe-result.v1",
          "execution_mode": "source-native-observation",
          "id": "network.http-tls.observe",
          "state": "ready"
        },
        {
          "contract": "probe-result.v1",
          "execution_mode": "source-native-observation",
          "id": "network.quic.observe",
          "state": "ready"
        },
        {
          "contract": "probe-result.v1",
          "execution_mode": "source-native-observation",
          "id": "network.transfer.observe",
          "state": "ready"
        },
        {
          "contract": "probe-result.v1",
          "execution_mode": "source-native-observation",
          "id": "network.connection-lifetime.observe",
          "state": "ready"
        }
      ],
      "consequence_class": "bounded observation by default; explicit private network mutation remains manual",
      "cost_model": {
        "fixed": "local Rust binaries and optional sanitized SQLite history",
