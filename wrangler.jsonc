{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ordivon-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "EDGE_HMAC_KEY_ID": "runtime-v1",
    "FETCH_ALLOWED_HOSTS": "developers.cloudflare.com,api.github.com,raw.githubusercontent.com,github.com,example.com,openai.com"
  },
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "ordivon-artifacts"
    }
  ],
  "routes": [
    {
      "pattern": "edge.ordivon.com",
      "custom_domain": true
    }
  ]
}
