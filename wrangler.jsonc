{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ordivon-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "ordivon-artifacts"
    }
  ]
}
