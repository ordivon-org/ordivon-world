{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordivon.com/contracts/world/edge-capabilities.schema.json",
  "title": "Ordivon Edge Capability Document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "service",
    "policy_version",
    "retention",
    "capabilities",
    "worker_version",
    "deployment_identity"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "service": {"const": "ordivon-edge"},
    "policy_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "idempotency_days",
        "request_state_days",
        "receipt_mirror_days",
        "artifact_days",
        "cleanup_task_days"
      ],
      "properties": {
        "idempotency_days": {"type": "integer", "minimum": 1},
        "request_state_days": {"type": "integer", "minimum": 1},
        "receipt_mirror_days": {"type": "integer", "minimum": 1},
        "artifact_days": {"type": "integer", "minimum": 1},
        "cleanup_task_days": {"type": "integer", "minimum": 1}
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "state", "reason"],
        "properties": {
          "id": {"type": "string", "enum": ["artifact.get", "fetch", "browser.run", "receipt"]},
          "version": {"type": "string", "minLength": 1, "maxLength": 128},
          "state": {"const": "ready"},
          "reason": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      }
    },
    "worker_version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tag", "timestamp"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "tag": {"type": "string", "minLength": 1, "maxLength": 256},
        "timestamp": {"type": "string", "format": "date-time"}
      }
    },
    "deployment_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_commit", "worker_release_digest"],
      "properties": {
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{12,40}$"},
        "worker_release_digest": {"type": "string", "pattern": "^[0-9a-f]{16,64}$"}
      }
    }
  }
}
