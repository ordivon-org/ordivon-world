{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordivon.com/contracts/world/entity-migration-not-committed.schema.json",
  "title": "Ordivon World Entity Migration Not-Committed Proof",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "migrationId",
    "planDigest",
    "entityId",
    "destinationWorldId",
    "sourceDepartureDigest",
    "continuityPayloadDigest",
    "evidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "ordivon.world.entity-migration-not-committed"
    },
    "migrationId": {
      "type": "string",
      "pattern": "^migration:.+",
      "maxLength": 512
    },
    "planDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "entityId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "destinationWorldId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "sourceDepartureDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "continuityPayloadDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evidence": {
      "type": "object",
      "required": [
        "authority",
        "exactOriginalRetrySafe",
        "nativeSubstrateChecked"
      ],
      "properties": {
        "authority": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "exactOriginalRetrySafe": {
          "const": true
        },
        "nativeSubstrateChecked": {
          "const": true
        }
      }
    }
  }
}
