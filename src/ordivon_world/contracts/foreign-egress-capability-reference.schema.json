{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordivon.com/contracts/world/foreign-egress-capability-reference.schema.json",
  "title": "Ordivon World Foreign Egress Capability Reference",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "capabilityDigest",
    "observationDigest",
    "pathDigest",
    "freshUntil",
    "activationAuthority",
    "requiresOwnerRevalidation"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "ordivon.world.foreign-egress-capability-reference"},
    "capabilityDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "observationDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "pathDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "freshUntil": {"type": "string", "format": "date-time"},
    "activationAuthority": {"const": "ordivon.workstation.surfpath"},
    "requiresOwnerRevalidation": {"const": true}
  }
}
