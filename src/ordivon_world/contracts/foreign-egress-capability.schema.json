{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordivon.com/contracts/world/foreign-egress-capability.schema.json",
  "title": "Ordivon World Foreign Egress Capability Projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "truthRole", "capabilityType", "owner", "observedAt", "freshUntil", "relationship", "requiredTargets", "activationAuthority", "requiresOwnerRevalidation", "capabilityDigest"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "ordivon.world.foreign-egress-capability"},
    "truthRole": {"const": "owner-observed-capability-projection"},
    "capabilityType": {"const": "foreign-egress"},
    "owner": {
      "type": "object", "additionalProperties": false,
      "required": ["authority", "observationKind", "observationDigest", "pathDigest", "catalogDigest", "freshnessWindowSeconds"],
      "properties": {
        "authority": {"const": "ordivon.workstation.surfpath"},
        "observationKind": {"const": "ordivon.workstation.surfshark-path-observation"},
        "observationDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "pathDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "catalogDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "freshnessWindowSeconds": {"type": "integer", "minimum": 1}
      }
    },
    "observedAt": {"type": "string", "format": "date-time"},
    "freshUntil": {"type": "string", "format": "date-time"},
    "relationship": {
      "type": "object", "additionalProperties": false,
      "required": ["ingress", "transport", "node", "endpoint", "providerEvidenceDigest", "configDigest", "egress", "targets"],
      "properties": {
        "ingress": {
          "type": "object", "additionalProperties": false,
          "required": ["name", "routeProfile"],
          "properties": {"name": {"type": "string", "minLength": 1}, "routeProfile": {"type": ["string", "null"]}}
        },
        "transport": {"type": "string", "minLength": 1},
        "node": {"type": "string", "minLength": 1},
        "endpoint": {
          "type": "object", "additionalProperties": false,
          "required": ["host", "ip", "port"],
          "properties": {"host": {"type": "string", "minLength": 1}, "ip": {"type": "string", "minLength": 1}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}}
        },
        "providerEvidenceDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "configDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "egress": {
          "type": ["object", "null"], "additionalProperties": false,
          "required": ["ip", "location", "colo"],
          "properties": {"ip": {"type": ["string", "null"]}, "location": {"type": ["string", "null"]}, "colo": {"type": ["string", "null"]}}
        },
        "targets": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "url", "selectedAddress"],
            "properties": {"name": {"type": "string", "minLength": 1}, "url": {"type": "string", "format": "uri"}, "selectedAddress": {"type": "string", "minLength": 1}}
          }
        }
      }
    },
    "requiredTargets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "activationAuthority": {"const": "ordivon.workstation.surfpath"},
    "requiresOwnerRevalidation": {"const": true},
    "capabilityDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
