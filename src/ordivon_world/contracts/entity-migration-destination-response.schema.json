{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordivon.com/contracts/world/entity-migration-destination-response.schema.json",
  "title": "Ordivon World Entity Migration Destination Response",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "status",
        "receipt"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "ordivon.world.entity-migration-destination-response"
        },
        "status": {
          "const": "materialized"
        },
        "receipt": {
          "$ref": "https://ordivon.com/contracts/world/entity-migration-receipt.schema.json"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "status",
        "migrationId",
        "planDigest",
        "entityId",
        "destinationWorldId",
        "sourceDepartureDigest",
        "continuityPayloadDigest",
        "evidence"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "ordivon.world.entity-migration-destination-response"
        },
        "status": {
          "const": "not_committed"
        },
        "migrationId": {
          "type": "string",
          "pattern": "^migration:.+",
          "maxLength": 512
        },
        "planDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "entityId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "destinationWorldId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "sourceDepartureDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "continuityPayloadDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "evidence": {
          "type": "object",
          "required": [
            "authority",
            "exactOriginalRetrySafe",
            "nativeSubstrateChecked"
          ],
          "properties": {
            "authority": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "exactOriginalRetrySafe": {
              "const": true
            },
            "nativeSubstrateChecked": {
              "const": true
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "status",
        "migrationId",
        "planDigest",
        "reason"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "ordivon.world.entity-migration-destination-response"
        },
        "status": {
          "const": "unknown"
        },
        "migrationId": {
          "type": "string",
          "pattern": "^migration:.+",
          "maxLength": 512
        },
        "planDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "status",
        "code",
        "reason"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "ordivon.world.entity-migration-destination-response"
        },
        "status": {
          "const": "rejected"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    }
  ]
}
