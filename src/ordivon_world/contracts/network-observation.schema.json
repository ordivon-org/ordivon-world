{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ordivon.com/contracts/world/network-observation.schema.json",
  "title": "Ordivon World Network Condition Observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "capturedAt",
    "observer",
    "topology",
    "profile",
    "egress",
    "wireguard",
    "freshUntil",
    "observationDigest"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "ordivon.world.network-observation"},
    "capturedAt": {"type": "string", "format": "date-time"},
    "observer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "sourceRevision"],
      "properties": {
        "tool": {"type": "string", "minLength": 1},
        "sourceRevision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "topology": {"type": "string", "minLength": 1},
    "profile": {"type": ["string", "null"]},
    "egress": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["ipFingerprint", "country", "colo"],
      "properties": {
        "ipFingerprint": {"type": ["string", "null"], "pattern": "^[0-9a-f]{16}$"},
        "country": {"type": ["string", "null"], "maxLength": 8},
        "colo": {"type": ["string", "null"], "maxLength": 16}
      }
    },
    "wireguard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handshakeAgeSeconds"],
      "properties": {
        "handshakeAgeSeconds": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "freshUntil": {"type": "string", "format": "date-time"},
    "observationDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
