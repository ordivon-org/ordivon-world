#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$ROOT"

UV=${UV:-$(command -v uv)}
UVX=${UVX:-$(command -v uvx)}

"$UV" lock --check
"$ROOT/scripts/owner-environment" test
PYTHON="$ROOT/.venv/bin/python"
"$PYTHON" -m compileall -q src tests scripts

(
  cd providers/cloudflare
  pnpm install --frozen-lockfile
)
"$PYTHON" scripts/check_contracts.py
(
  cd providers/cloudflare
  pnpm run ci
)

"$UVX" pip-audit -r requirements-audit.txt

rm -rf build target/local-acceptance-wheel
mkdir -p target/local-acceptance-wheel
"$UV" build --wheel --out-dir target/local-acceptance-wheel
"$PYTHON" scripts/check_wheel.py target/local-acceptance-wheel

git diff --check
printf '%s\n' 'portable_acceptance=passed' 'live_owner_acceptance=separate_required_gate'
