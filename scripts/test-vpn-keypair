#!/usr/bin/env bash
set -euo pipefail
umask 077
root=$(cd "$(dirname "$0")/.." && pwd)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
install -d -m 700 "$tmp/templates" "$tmp/secrets" "$tmp/backups"
cat > "$tmp/templates/jp-tok.conf" <<'EOF'
[Interface]
Address = 10.0.0.2/32
PrivateKey = <insert_your_private_key_here>
DNS = 1.1.1.1

[Peer]
PublicKey = AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
AllowedIPs = 0.0.0.0/0
Endpoint = 203.0.113.10:51820
PersistentKeepalive = 25
EOF
private_one="$tmp/private-one"
public_one="$tmp/public-one"
private_two="$tmp/private-two"
public_two="$tmp/public-two"
wg genkey > "$private_one"
wg pubkey < "$private_one" > "$public_one"
wg genkey > "$private_two"
wg pubkey < "$private_two" > "$public_two"
chmod 600 "$private_one" "$public_one" "$private_two" "$public_two"

ORDIVON_VPN_SECRET_DIR="$tmp/secrets" \
ORDIVON_VPN_TEMPLATE_DIR="$tmp/templates" \
ORDIVON_VPN_RENDERED_DIR="$tmp/secrets/rendered" \
ORDIVON_VPN_BACKUP_DIR="$tmp/backups" \
  "$root/scripts/ordivon-vpn-keypair" \
  --public-key-file "$public_one" \
  --private-key-file "$private_one" > "$tmp/success.json"

cmp -s "$private_one" "$tmp/secrets/ordivon-manual.private"
cmp -s "$public_one" "$tmp/secrets/ordivon-manual.public"
[[ $(stat -c %a "$tmp/secrets/ordivon-manual.private") == 600 ]]
[[ $(stat -c %a "$tmp/secrets/rendered/jp-tok.conf") == 600 ]]
grep -Fq "PrivateKey = $(cat "$private_one")" "$tmp/secrets/rendered/jp-tok.conf"
wg-quick strip "$tmp/secrets/rendered/jp-tok.conf" >/dev/null

ORDIVON_VPN_CONFIG_DIR="$tmp/secrets/rendered" \
ORDIVON_VPN_PUBLIC_KEY_PATH="$tmp/secrets/ordivon-manual.public" \
ORDIVON_VPN_PRIVATE_KEY_PATH="$tmp/secrets/ordivon-manual.private" \
  "$root/scripts/ordivon-vpn" doctor jp-tok > "$tmp/doctor-consistent.json"
python3 - "$tmp/doctor-consistent.json" <<'PY'
import json,sys
value=json.load(open(sys.argv[1]))
assert value["config_valid"] is True
assert value["key_pair_consistent"] is True
PY

python3 - "$private_two" "$tmp/secrets/rendered/jp-tok.conf" <<'PY'
from pathlib import Path
import re,sys
private=Path(sys.argv[1]).read_text().strip()
p=Path(sys.argv[2])
s=p.read_text()
s,n=re.subn(r'(?m)^(\s*PrivateKey\s*=\s*).+$',lambda m:m.group(1)+private,s,count=1)
assert n==1
p.write_text(s)
PY
set +e
ORDIVON_VPN_CONFIG_DIR="$tmp/secrets/rendered" \
ORDIVON_VPN_PUBLIC_KEY_PATH="$tmp/secrets/ordivon-manual.public" \
ORDIVON_VPN_PRIVATE_KEY_PATH="$tmp/secrets/ordivon-manual.private" \
  "$root/scripts/ordivon-vpn" doctor jp-tok > "$tmp/doctor-inconsistent.json"
doctor_rc=$?
set -e
[[ $doctor_rc -ne 0 ]]
python3 - "$tmp/doctor-inconsistent.json" <<'PY'
import json,sys
value=json.load(open(sys.argv[1]))
assert value["config_valid"] is True
assert value["key_pair_consistent"] is False
PY
cp "$private_one" "$tmp/secrets/ordivon-manual.private"
python3 - "$private_one" "$tmp/secrets/rendered/jp-tok.conf" <<'PY'
from pathlib import Path
import re,sys
private=Path(sys.argv[1]).read_text().strip()
p=Path(sys.argv[2])
s=p.read_text()
s,n=re.subn(r'(?m)^(\s*PrivateKey\s*=\s*).+$',lambda m:m.group(1)+private,s,count=1)
assert n==1
p.write_text(s)
PY
before=$(sha256sum "$tmp/secrets/ordivon-manual.private" "$tmp/secrets/rendered/jp-tok.conf")

set +e
ORDIVON_VPN_SECRET_DIR="$tmp/secrets" \
ORDIVON_VPN_TEMPLATE_DIR="$tmp/templates" \
ORDIVON_VPN_RENDERED_DIR="$tmp/secrets/rendered" \
ORDIVON_VPN_BACKUP_DIR="$tmp/backups" \
  "$root/scripts/ordivon-vpn-keypair" \
  --public-key-file "$public_two" \
  --private-key-file "$private_one" >/dev/null 2>"$tmp/mismatch.err"
rc=$?
set -e
[[ $rc -ne 0 ]]
after=$(sha256sum "$tmp/secrets/ordivon-manual.private" "$tmp/secrets/rendered/jp-tok.conf")
[[ $before == "$after" ]]
grep -Fq 'not the same WireGuard key pair' "$tmp/mismatch.err"

python3 - "$tmp/success.json" <<'PY'
import json,sys
value=json.load(open(sys.argv[1]))
assert value["installed"] is True
assert value["key_pair_verified"] is True
assert value["rendered_configs"] == 1
assert value["private_key_printed"] is False
print("vpn_keypair_tests=passed")
PY
