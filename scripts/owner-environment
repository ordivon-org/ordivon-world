#!/usr/bin/env bash
set -euo pipefail
repo=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
mode=${1:-}
uv_bin=${UV_BIN:-$(command -v uv || true)}
env_dir=${ORDIVON_OWNER_ENV_DIR:-"$repo/.venv"}
python_bin="$env_dir/bin/python"

usage() {
  cat <<'TXT'
usage: scripts/owner-environment bootstrap|doctor|test|cold-start

bootstrap   materialize the locked World runtime + dev profile
doctor      verify installed package graph and exact development tool
test        bootstrap, doctor, lint, unit tests, contracts, and docs
cold-start  prove the same default profile from a fresh temporary environment

Live Host/Cloudflare acceptance remains an explicit external-capability gate.
TXT
}
require_uv() { [[ -n "$uv_bin" ]] || { echo 'World owner environment requires uv' >&2; exit 1; }; }
bootstrap() {
  require_uv
  UV_PROJECT_ENVIRONMENT="$env_dir" "$uv_bin" sync --frozen --group dev
}
doctor() {
  [[ -x "$python_bin" ]] || { echo "World owner environment is not materialized: $python_bin" >&2; exit 1; }
  (cd "$repo" && "$python_bin" - <<'PY'
import importlib.metadata as md
import sys
import ordivon_world, ordivon_host, ordivon_protocol, jsonschema, ruff
if sys.version_info[:2] != (3, 12):
    raise SystemExit(f"World requires Python 3.12, got {sys.version.split()[0]}")
if md.version("ruff") != "0.15.17":
    raise SystemExit(f"unexpected Ruff version: {md.version('ruff')}")
print("owner environment doctor: valid profile=test")
PY
  )
  (cd "$repo" && "$python_bin" scripts/check_dependencies.py)
}
run_tests() {
  bootstrap
  doctor
  cd "$repo"
  "$python_bin" -m ruff check src tests scripts providers/cloudflare/scripts/ordivon_edge_gc.py providers/cloudflare/test/gc_test.py
  "$python_bin" -W error::ResourceWarning -m unittest discover -s tests -q
  "$python_bin" scripts/check_contracts.py --skip-provider-fixtures
  "$python_bin" scripts/check_docs.py
}
case "$mode" in
  bootstrap) bootstrap ;;
  doctor) doctor ;;
  test) run_tests ;;
  cold-start)
    tmp=$(mktemp -d -t ordivon-world-owner-env-XXXXXX)
    trap 'rm -rf "$tmp"' EXIT
    ORDIVON_OWNER_ENV_DIR="$tmp/.venv" "$0" test
    ;;
  --help|-h) usage ;;
  *) usage >&2; exit 2 ;;
esac
