#!/usr/bin/env bash
set -euo pipefail

PROGRAM="ordivon-vpn"
NAMESPACE="${ORDIVON_VPN_NAMESPACE:-ordivon-vpn}"
WG_INTERFACE="${ORDIVON_VPN_WG_INTERFACE:-wg0}"
CONFIG_DIR="${ORDIVON_VPN_CONFIG_DIR:-/root/.config/ordivon/secrets/surfshark/rendered}"
PUBLIC_KEY_PATH="${ORDIVON_VPN_PUBLIC_KEY_PATH:-/root/.config/ordivon/secrets/surfshark/ordivon-manual.public}"
PRIVATE_KEY_PATH="${ORDIVON_VPN_PRIVATE_KEY_PATH:-/root/.config/ordivon/secrets/surfshark/ordivon-manual.private}"
STATE_DIR="${ORDIVON_VPN_STATE_DIR:-/run/ordivon-vpn}"
STATE_FILE="$STATE_DIR/state"
RESOLV_DIR="/etc/netns/$NAMESPACE"
WINDOWS_POWERSHELL="/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe"

log() { printf '%s: %s\n' "$PROGRAM" "$*" >&2; }
die() { log "$*"; exit 1; }
require_root() { [[ ${EUID:-$(id -u)} -eq 0 ]] || die "must run as root"; }
require_command() { command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"; }
namespace_exists() { ip netns list | awk '{print $1}' | grep -Fxq "$NAMESPACE"; }

windows_surfshark_active() {
  [[ -f $WINDOWS_POWERSHELL ]] || return 1
  "$WINDOWS_POWERSHELL" -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command \
    "\$service=Get-Service -Name 'Surfshark WireGuard' -ErrorAction SilentlyContinue; \
     \$adapter=Get-NetAdapter -Name 'SurfsharkWireGuard' -IncludeHidden -ErrorAction SilentlyContinue; \
     if ((\$service -and \$service.Status -eq 'Running') -or (\$adapter -and \$adapter.Status -eq 'Up')) { exit 0 } else { exit 1 }" \
    >/dev/null 2>&1
}

ensure_outer_surfshark_disconnected() {
  if windows_surfshark_active; then
    die "Windows Surfshark is active; disconnect it before starting the isolated namespace"
  fi
}

usage() {
  cat <<'EOF'
Usage:
  ordivon-vpn doctor [profile]
  ordivon-vpn list
  ordivon-vpn up <profile>
  ordivon-vpn down
  ordivon-vpn status
  ordivon-vpn egress
  ordivon-vpn exec <command> [args...]

Profiles are configuration basenames without the .conf suffix. Private keys and
endpoint addresses are never printed by this controller.
EOF
}

profile_name() {
  local value=${1:-}
  [[ $value =~ ^[a-z0-9][a-z0-9-]{0,30}$ ]] || die "invalid profile name"
  printf '%s' "$value"
}

config_path() {
  local profile
  profile=$(profile_name "$1")
  printf '%s/%s.conf' "$CONFIG_DIR" "$profile"
}

key_pair_consistent() {
  local config=$1 config_private stored_private stored_public config_public private_public
  [[ -f $PUBLIC_KEY_PATH && ! -L $PUBLIC_KEY_PATH ]] || return 1
  [[ -f $PRIVATE_KEY_PATH && ! -L $PRIVATE_KEY_PATH ]] || return 1
  [[ $(stat -c %a "$PUBLIC_KEY_PATH" 2>/dev/null) == 600 ]] || return 1
  [[ $(stat -c %a "$PRIVATE_KEY_PATH" 2>/dev/null) == 600 ]] || return 1
  stored_public=$(tr -d '\r\n' < "$PUBLIC_KEY_PATH")
  stored_private=$(tr -d '\r\n' < "$PRIVATE_KEY_PATH")
  config_private=$(awk '/^[[:space:]]*PrivateKey[[:space:]]*=/{value=substr($0,index($0,"=")+1); gsub(/[[:space:]]/,"",value); print value; exit}' "$config")
  [[ -n $stored_public && -n $stored_private && -n $config_private ]] || return 1
  private_public=$(printf '%s\n' "$stored_private" | wg pubkey 2>/dev/null) || return 1
  config_public=$(printf '%s\n' "$config_private" | wg pubkey 2>/dev/null) || return 1
  [[ $private_public == "$stored_public" && $config_public == "$stored_public" ]]
}

validate_config() {
  local config=$1
  [[ -f $config ]] || die "profile config not found"
  [[ ! -L $config ]] || die "profile config must not be a symlink"
  [[ $(stat -c %a "$config") == 600 ]] || die "profile config must have mode 0600"
  grep -q '<insert_your_private_key_here>' "$config" && die "profile config still contains a private-key placeholder"
  wg-quick strip "$config" >/dev/null || die "profile config is not a valid WireGuard configuration"
  key_pair_consistent "$config" || die "profile config key does not match the installed Surfshark key pair"
}

state_value() {
  local key=$1
  [[ -f $STATE_FILE ]] || return 1
  awk -F= -v wanted="$key" '$1 == wanted { print substr($0, index($0, "=") + 1); exit }' "$STATE_FILE"
}

write_state() {
  local profile=$1
  install -d -m 700 "$STATE_DIR"
  local temporary
  temporary=$(mktemp "$STATE_DIR/.state.XXXXXX")
  chmod 600 "$temporary"
  {
    printf 'profile=%s\n' "$profile"
    printf 'topology=wireguard-birth-namespace\n'
    printf 'created_at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  } > "$temporary"
  mv -f "$temporary" "$STATE_FILE"
}

cleanup_network() {
  set +e
  # Covers a failure before the interface is moved into the target namespace.
  ip link del "$WG_INTERFACE" 2>/dev/null
  # Covers the normal case: deleting the namespace also deletes the moved interface.
  ip netns del "$NAMESPACE" 2>/dev/null
  rm -rf "$RESOLV_DIR"
  rm -f "$STATE_FILE"
  set -e
}

resolve_endpoint() {
  local config=$1 endpoint host port address ip
  endpoint=$(awk -F= '/^[[:space:]]*Endpoint[[:space:]]*=/{gsub(/[[:space:]]/,"",$2); print $2; exit}' "$config")
  address=$(awk -F= '/^[[:space:]]*Address[[:space:]]*=/{gsub(/[[:space:]]/,"",$2); print $2; exit}' "$config")
  [[ -n $endpoint && -n $address ]] || die "profile config is missing Address or Endpoint"
  host=${endpoint%:*}
  port=${endpoint##*:}
  [[ $port =~ ^[0-9]+$ ]] || die "profile endpoint port is invalid"
  ip=$(getent ahostsv4 "$host" | awk 'NR == 1 { print $1 }')
  [[ -n $ip ]] || die "profile endpoint could not be resolved"
  printf '%s\t%s\t%s\n' "$ip" "$port" "${address%%,*}"
}

write_resolver() {
  local config=$1 dns
  dns=$(awk -F= '/^[[:space:]]*DNS[[:space:]]*=/{print $2; exit}' "$config" | tr ',' '\n' | xargs -n1 2>/dev/null || true)
  install -d -m 755 "$RESOLV_DIR"
  : > "$RESOLV_DIR/resolv.conf"
  while IFS= read -r server; do
    [[ $server =~ ^[0-9a-fA-F:.]+$ ]] && printf 'nameserver %s\n' "$server" >> "$RESOLV_DIR/resolv.conf"
  done <<< "$dns"
  [[ -s $RESOLV_DIR/resolv.conf ]] || printf 'nameserver 1.1.1.1\n' > "$RESOLV_DIR/resolv.conf"
  printf 'options timeout:2 attempts:2\n' >> "$RESOLV_DIR/resolv.conf"
}

probe_trace() {
  local prefix=("$@") result=''
  for _ in $(seq 1 8); do
    result=$("${prefix[@]}" curl -4fsS --connect-timeout 6 --max-time 15 https://www.cloudflare.com/cdn-cgi/trace 2>/dev/null || true)
    grep -q '^ip=' <<< "$result" && { printf '%s' "$result"; return 0; }
    sleep 2
  done
  return 1
}

command_list() {
  [[ -d $CONFIG_DIR ]] || return 0
  find "$CONFIG_DIR" -maxdepth 1 -type f -name '*.conf' -printf '%f\n' \
    | sed 's/\.conf$//' | LC_ALL=C sort
}

command_doctor() {
  local profile=${1:-jp-tok} config
  config=$(config_path "$profile")
  local missing=() command
  for command in ip wg wg-quick curl getent awk sed grep stat python3 flock; do
    command -v "$command" >/dev/null 2>&1 || missing+=("$command")
  done
  local config_ok=false key_pair_ok=false placeholder=false mode=null outer_active=null
  if [[ -f $WINDOWS_POWERSHELL ]]; then
    if windows_surfshark_active; then outer_active=true; else outer_active=false; fi
  fi
  if [[ -f $config && ! -L $config ]]; then
    mode=$(stat -c %a "$config" 2>/dev/null || printf null)
    grep -q '<insert_your_private_key_here>' "$config" && placeholder=true
    if [[ $mode == 600 && $placeholder == false ]] && wg-quick strip "$config" >/dev/null 2>&1; then
      config_ok=true
      if key_pair_consistent "$config"; then key_pair_ok=true; fi
    fi
  fi
  python3 - "$profile" "$config_ok" "$key_pair_ok" "$placeholder" "$mode" "$outer_active" "${#missing[@]}" "${missing[*]:-}" <<'PY'
import json,sys
profile,config_ok,key_pair_ok,placeholder,mode,outer_active,count,missing=sys.argv[1:]
print(json.dumps({
  "profile": profile,
  "config_valid": config_ok == "true",
  "key_pair_consistent": key_pair_ok == "true",
  "private_key_placeholder": placeholder == "true",
  "config_mode": None if mode == "null" else mode,
  "windows_surfshark_active": None if outer_active == "null" else outer_active == "true",
  "topology": "wireguard-birth-namespace",
  "missing_commands": [] if int(count) == 0 else missing.split(),
}, indent=2))
PY
  [[ ${#missing[@]} -eq 0 && $config_ok == true && $key_pair_ok == true ]]
}

command_up() {
  require_root
  local profile config current_profile
  profile=$(profile_name "${1:-}")
  config=$(config_path "$profile")
  validate_config "$config"
  probe_trace >/dev/null || die "root namespace HTTPS egress is unavailable"
  ensure_outer_surfshark_disconnected
  if namespace_exists; then
    current_profile=$(state_value profile 2>/dev/null || true)
    [[ $current_profile == "$profile" ]] || die "namespace is already active with another or unknown profile; run down first"
    command_status
    return 0
  fi

  local endpoint_ip endpoint_port tunnel_address temporary success=false
  IFS=$'\t' read -r endpoint_ip endpoint_port tunnel_address < <(resolve_endpoint "$config")
  temporary=$(mktemp /run/ordivon-vpn.XXXXXX.conf)
  chmod 600 "$temporary"
  wg-quick strip "$config" > "$temporary"
  sed -i -E "s#^[[:space:]]*Endpoint[[:space:]]*=.*#Endpoint = ${endpoint_ip}:${endpoint_port}#" "$temporary"

  rollback() {
    rm -f "$temporary"
    if [[ $success != true ]]; then cleanup_network; fi
  }
  trap rollback EXIT

  ip netns add "$NAMESPACE"
  write_resolver "$config"

  # WireGuard remembers the namespace in which it is created. Its encrypted UDP
  # socket therefore remains in the root namespace after the interface moves.
  # Cleartext traffic and routes live only in the target namespace.
  ip link add "$WG_INTERFACE" type wireguard
  ip link set "$WG_INTERFACE" netns "$NAMESPACE"
  ip netns exec "$NAMESPACE" ip link set lo up
  ip netns exec "$NAMESPACE" wg setconf "$WG_INTERFACE" "$temporary"
  ip netns exec "$NAMESPACE" ip addr add "$tunnel_address" dev "$WG_INTERFACE"
  ip netns exec "$NAMESPACE" ip link set mtu 1280 up dev "$WG_INTERFACE"
  ip netns exec "$NAMESPACE" ip route add default dev "$WG_INTERFACE"

  local trace handshake=0 now age=999999
  trace=$(probe_trace ip netns exec "$NAMESPACE" || true)
  handshake=$(ip netns exec "$NAMESPACE" wg show "$WG_INTERFACE" latest-handshakes | awk 'NR == 1 { print $2 }')
  now=$(date +%s)
  [[ ${handshake:-0} -gt 0 ]] && age=$((now - handshake))
  [[ -n $trace && $age -lt 120 ]] || die "WireGuard handshake or egress verification failed"

  write_state "$profile"
  success=true
  rm -f "$temporary"
  trap - EXIT
  command_status
}

command_down() {
  require_root
  cleanup_network
  printf '{"active":false,"namespace":"%s"}\n' "$NAMESPACE"
}

command_status() {
  local active=false profile='' topology='' handshake=0 now age=null rx=0 tx=0 trace='' ip='' country=''
  if namespace_exists && ip netns exec "$NAMESPACE" ip link show "$WG_INTERFACE" >/dev/null 2>&1; then
    active=true
    profile=$(state_value profile 2>/dev/null || true)
    topology=$(state_value topology 2>/dev/null || true)
    handshake=$(ip netns exec "$NAMESPACE" wg show "$WG_INTERFACE" latest-handshakes | awk 'NR == 1 { print $2 }')
    rx=$(ip netns exec "$NAMESPACE" wg show "$WG_INTERFACE" transfer | awk 'NR == 1 { print $2 }')
    tx=$(ip netns exec "$NAMESPACE" wg show "$WG_INTERFACE" transfer | awk 'NR == 1 { print $3 }')
    if [[ ${handshake:-0} -gt 0 ]]; then now=$(date +%s); age=$((now - handshake)); fi
    trace=$(ip netns exec "$NAMESPACE" curl -4fsS --connect-timeout 4 --max-time 10 https://www.cloudflare.com/cdn-cgi/trace 2>/dev/null || true)
    ip=$(awk -F= '$1 == "ip" { print $2 }' <<< "$trace")
    country=$(awk -F= '$1 == "loc" { print $2 }' <<< "$trace")
  fi
  python3 - "$active" "$profile" "$topology" "$age" "$rx" "$tx" "$ip" "$country" "$NAMESPACE" <<'PY'
import json,sys
active,profile,topology,age,rx,tx,ip,country,namespace=sys.argv[1:]
print(json.dumps({
  "active": active == "true",
  "namespace": namespace,
  "profile": profile or None,
  "topology": topology or None,
  "latest_handshake_age_seconds": None if age == "null" else int(age),
  "received_bytes": int(rx),
  "sent_bytes": int(tx),
  "egress": None if not ip else {"ip": ip, "country": country or None},
}, indent=2))
PY
}

command_egress() {
  namespace_exists || die "namespace is not active"
  ip netns exec "$NAMESPACE" curl -4fsS --connect-timeout 6 --max-time 15 https://www.cloudflare.com/cdn-cgi/trace \
    | awk -F= '$1 == "ip" || $1 == "loc" || $1 == "colo" || $1 == "warp" { print }'
}

command_exec() {
  namespace_exists || die "namespace is not active"
  [[ $# -gt 0 ]] || die "exec requires a command"
  exec ip netns exec "$NAMESPACE" "$@"
}

main() {
  local command=${1:-}
  [[ -n $command ]] || { usage; exit 2; }
  shift
  case "$command" in
    doctor) command_doctor "$@" ;;
    list) command_list ;;
    up)
      require_command flock
      exec 9> /run/ordivon-vpn.lock
      flock -x 9
      command_up "$@"
      ;;
    down)
      require_command flock
      exec 9> /run/ordivon-vpn.lock
      flock -x 9
      command_down
      ;;
    status) command_status ;;
    egress) command_egress ;;
    exec) command_exec "$@" ;;
    help|-h|--help) usage ;;
    *) usage >&2; exit 2 ;;
  esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
