#!/usr/bin/env bash
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
log="$tmp/iptables.log"
cat > "$tmp/iptables" <<'MOCK'
#!/usr/bin/env bash
set -u
printf '%s\n' "$*" >> "$IPTABLES_LOG"
if [[ ${1:-} == -n && ${2:-} == -L && ${3:-} == DOCKER-USER ]]; then
  [[ ${MOCK_DOCKER_USER:-present} == present ]]
  exit
fi
if [[ ${1:-} == -C ]]; then exit 1; fi
exit 0
MOCK
chmod 755 "$tmp/iptables"
export PATH="$tmp:$PATH" IPTABLES_LOG="$log"
# shellcheck source=/dev/null
source "$root/scripts/ordivon-vpn"
HOST_VETH=ovpn-test

MOCK_DOCKER_USER=present
export MOCK_DOCKER_USER
chain=$(add_forward_rules eth0)
[[ $chain == DOCKER-USER ]]
remove_forward_rules eth0 "$chain"
grep -Fq -- '-I DOCKER-USER 1 -i ovpn-test -o eth0 -j ACCEPT' "$log"
grep -Fq -- '-I DOCKER-USER 1 -i eth0 -o ovpn-test -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT' "$log"
grep -Fq -- '-D DOCKER-USER -i ovpn-test -o eth0 -j ACCEPT' "$log"
grep -Fq -- '-D DOCKER-USER -i eth0 -o ovpn-test -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT' "$log"

: > "$log"
MOCK_DOCKER_USER=absent
export MOCK_DOCKER_USER
chain=$(add_forward_rules eth1)
[[ $chain == FORWARD ]]
remove_forward_rules eth1 "$chain"
grep -Fq -- '-I FORWARD 1 -i ovpn-test -o eth1 -j ACCEPT' "$log"
grep -Fq -- '-D FORWARD -i ovpn-test -o eth1 -j ACCEPT' "$log"
printf 'vpn_forwarding_tests=passed\n'
